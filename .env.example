# Server Configuration
SERVER_PORT=8080

# Database Configuration (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/vcraft_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
POSTGRES_DB=vcraft_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Security & JWT
# Empty = random signing key per startup. Set a private 32+ byte secret for stable sessions.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
JWT_SECRET=
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

# Uploads directory
FILE_UPLOAD_DIR=./uploads
# Public Base URL for QR codes / Tracing
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080

# Optional password-reset delivery. Disabled until an SMTP server is configured.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=noreply@vcraft.local
PASSWORD_RESET_URL=http://localhost:3000/reset-password
